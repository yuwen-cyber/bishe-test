<template>
  <div class="lab-page">
    <!-- 第 0 步：被试编号 + 知情说明 -->
    <el-card v-if="step === 0" shadow="never" class="lab-card">
      <template #header><span>用户记忆体验实验 · 开始</span></template>

      <el-alert type="info" :closable="false" show-icon class="tip">
        本实验为被试内设计：你将依次体验三种机器人回忆方式，每种体验后填写一份问卷。
        三种方式的呈现顺序由系统按被试编号随机平衡（拉丁方），请凭第一感受作答，答案无对错。
      </el-alert>

      <div class="form-row">
        <span class="label">被试编号</span>
        <el-input v-model="subjectId" placeholder="例如 S01、S02…" class="sid-input" clearable />
      </div>

      <h4>第一段对话记录（三条件共用的背景材料）</h4>
      <el-card shadow="hover" class="material">
        上周三你和机器人聊过：最近工作项目赶工期，连续加班一周，觉得压力很大、睡不好，有点烦躁；
        还提到家里养了一只猫，下班回家看到猫会放松一点。
      </el-card>

      <div class="actions">
        <el-button type="primary" :disabled="!subjectId.trim()" @click="begin">开始实验</el-button>
      </div>
    </el-card>

    <!-- 第 1~3 步：逐个条件体验 + 问卷 -->
    <el-card v-if="step >= 1 && step <= 3" shadow="never" class="lab-card">
      <template #header>
        <span>条件 {{ step }} / 3 · {{ conditionLabel(currentCondition) }}</span>
      </template>

      <el-alert :type="conditionAlertType(currentCondition)" :closable="false" show-icon class="tip">
        下面是机器人在本次条件下的开场回忆，请先阅读，再完成下方问卷。
      </el-alert>

      <h4>机器人的回忆</h4>
      <el-card shadow="hover" class="material speech">
        {{ conditionScript(currentCondition) }}
      </el-card>

      <h4>问卷（1 = 非常不同意，7 = 非常同意）</h4>
      <el-form label-position="top" class="survey">
        <div v-for="item in QUESTION_ITEMS" :key="item.code" class="question">
          <div class="q-text">{{ item.code }} · {{ item.text }}</div>
          <el-radio-group v-model="answers[currentCondition][item.code]">
            <el-radio-button v-for="n in 7" :key="n" :label="n">{{ n }}</el-radio-button>
          </el-radio-group>
        </div>
      </el-form>

      <el-alert v-if="step < 3" type="warning" :closable="false" class="tip">
        提交后请休息 2~3 分钟，再进入下一种条件。
      </el-alert>

      <div class="actions">
        <el-button @click="back">上一步</el-button>
        <el-button type="primary" :disabled="!currentAnswered" @click="submitCondition">
          {{ step === 3 ? '完成实验并导出数据' : '提交本条件' }}
        </el-button>
      </div>
    </el-card>

    <!-- 第 4 步：完成 + 导出 -->
    <el-card v-if="step === 4" shadow="never" class="lab-card">
      <template #header><span>实验完成</span></template>
      <el-result icon="success" title="三种条件均已完成" sub-title="请导出 CSV 交给实验负责人；数据同时保存在本浏览器 localStorage。" />

      <div class="actions">
        <el-button type="primary" @click="exportCsv">导出用户实验 CSV</el-button>
        <el-button @click="resetAll">清空本地记录并重新开始</el-button>
      </div>

      <el-table :data="savedRows" size="small" class="tip" v-if="savedRows.length">
        <el-table-column prop="subject_id" label="被试" width="90" />
        <el-table-column prop="condition" label="条件" width="130" />
        <el-table-column v-for="c in ITEM_CODES" :key="c" :prop="c" :label="c" width="70" />
      </el-table>
    </el-card>
  </div>
</template>

<script setup lang="ts">
import { computed, reactive, ref } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'

// ---- 题目定义（字段必须与 analyze_user_experiment.py 的 DIMENSION_ITEMS 一致）----
interface QuestionItem {
  code: string
  text: string
}

const QUESTION_ITEMS: QuestionItem[] = [
  { code: 'M1', text: '机器人记得我之前说过的内容' },
  { code: 'M2', text: '它的回忆和我的真实经历对得上' },
  { code: 'U1', text: '它理解我当时的心情' },
  { code: 'U2', text: '它的回应贴合我的处境' },
  { code: 'T1', text: '我愿意继续和它聊下去' },
  { code: 'T2', text: '我觉得它的回忆是可靠的' },
  { code: 'C1', text: '聊下来我感到被陪伴' },
  { code: 'C2', text: '它让我觉得不那么孤单' },
  { code: 'O1', text: '总体上我对这次体验满意' },
]
const ITEM_CODES = QUESTION_ITEMS.map((q) => q.code)

type Condition = 'no_memory' | 'keyword' | 'semantic'

// 拉丁方 6 种排列，按被试编号取模分配，平衡顺序效应
const ORDERS: Condition[][] = [
  ['no_memory', 'keyword', 'semantic'],
  ['no_memory', 'semantic', 'keyword'],
  ['keyword', 'no_memory', 'semantic'],
  ['keyword', 'semantic', 'no_memory'],
  ['semantic', 'no_memory', 'keyword'],
  ['semantic', 'keyword', 'no_memory'],
]

const CONDITION_LABEL: Record<Condition, string> = {
  no_memory: '条件一 · 无记忆（机器人不提及历史）',
  keyword: '条件二 · 关键词检索（按关键词回忆，可能记错）',
  semantic: '条件三 · 语义检索（准确回忆并自然表达）',
}

const CONDITION_SCRIPT: Record<Condition, string> = {
  no_memory:
    '“你好，今天想聊点什么？我是你的陪伴机器人，有什么开心或烦恼的事都可以和我说。”',
  keyword:
    '“我记得你之前提到过工作很忙、压力大……好像还说过你养了一只狗，平时遛狗能放松一些，是这样吗？”',
  semantic:
    '“你好呀，记得你上周说项目赶工期、连续加班，压力大到睡不好、有点烦躁；不过你提到家里有只猫，下班看到它会放松一点。今天感觉好一些了吗？”',
}

const STORAGE_KEY = 'user_experiment_rows'

// ---- 状态 ----
const subjectId = ref('')
const step = ref(0)
const order = ref<Condition[]>(ORDERS[0])
const savedRows = ref<Record<string, any>[]>(loadSavedRows())

const answers = reactive<Record<Condition, Record<string, number>>>({
  no_memory: {},
  keyword: {},
  semantic: {},
})

const currentCondition = computed<Condition>(() => order.value[step.value - 1])

const currentAnswered = computed(() => {
  const a = answers[currentCondition.value]
  return ITEM_CODES.every((c) => a[c] !== undefined && a[c] !== null)
})

function conditionLabel(c: Condition): string {
  return CONDITION_LABEL[c]
}

function conditionAlertType(c: Condition): 'info' | 'warning' | 'success' {
  if (c === 'no_memory') return 'info'
  if (c === 'keyword') return 'warning'
  return 'success'
}

function conditionScript(c: Condition): string {
  return CONDITION_SCRIPT[c]
}

// ---- 流程 ----
function hashOrderIndex(id: string): number {
  const trimmed = id.trim()
  const num = Number(trimmed.replace(/\D/g, ''))
  if (!Number.isNaN(num) && trimmed.replace(/\D/g, '') !== '') return num % ORDERS.length
  let h = 0
  for (const ch of trimmed) h = (h * 31 + ch.charCodeAt(0)) >>> 0
  return h % ORDERS.length
}

function begin() {
  order.value = ORDERS[hashOrderIndex(subjectId.value)]
  step.value = 1
}

function back() {
  if (step.value > 1) step.value -= 1
}

function submitCondition() {
  if (!currentAnswered.value) {
    ElMessage.warning('请完成本条件的全部题目后再提交')
    return
  }
  const cond = currentCondition.value
  const row: Record<string, any> = {
    subject_id: subjectId.value.trim(),
    condition: cond,
    order_index: order.value.indexOf(cond),
    timestamp: new Date().toISOString(),
  }
  for (const code of ITEM_CODES) row[code] = answers[cond][code]
  upsertRow(row)
  if (step.value === 3) {
    step.value = 4
  } else {
    step.value += 1
  }
}

// ---- localStorage 存取 ----
function loadSavedRows(): Record<string, any>[] {
  try {
    const raw = localStorage.getItem(STORAGE_KEY)
    return raw ? JSON.parse(raw) : []
  } catch {
    return []
  }
}

function upsertRow(row: Record<string, any>) {
  const rows = loadSavedRows()
  const idx = rows.findIndex((r) => r.subject_id === row.subject_id && r.condition === row.condition)
  if (idx >= 0) rows[idx] = row
  else rows.push(row)
  localStorage.setItem(STORAGE_KEY, JSON.stringify(rows))
  savedRows.value = rows
}

function exportCsv() {
  const rows = savedRows.value
  if (!rows.length) {
    ElMessage.warning('暂无可导出的数据')
    return
  }
  const header = ['subject_id', 'condition', ...ITEM_CODES, 'order_index', 'timestamp']
  const lines = [header.join(',')]
  for (const r of rows) {
    lines.push(header.map((h) => `"${String(r[h] ?? '').replace(/"/g, '""')}"`).join(','))
  }
  const csv = '﻿' + lines.join('\r\n')
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' })
  const url = URL.createObjectURL(blob)
  const a = document.createElement('a')
  a.href = url
  a.download = `user_experiment_${subjectId.value.trim() || 'export'}.csv`
  a.click()
  URL.revokeObjectURL(url)
  ElMessage.success('CSV 已导出，可交给实验负责人用统计脚本分析')
}

async function resetAll() {
  await ElMessageBox.confirm('确定清空本浏览器保存的全部实验记录吗？此操作不可恢复。', '提示', {
    type: 'warning',
  })
  localStorage.removeItem(STORAGE_KEY)
  savedRows.value = []
  step.value = 0
  subjectId.value = ''
  ElMessage.success('已清空')
}
</script>

<style scoped>
.lab-page {
  max-width: 860px;
  margin: 0 auto;
}
.lab-card {
  margin-bottom: 16px;
}
.tip {
  margin: 12px 0;
}
.form-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 16px 0;
}
.label {
  font-weight: 600;
  color: #303133;
}
.sid-input {
  width: 220px;
}
.material {
  background: #f9fafb;
  line-height: 1.7;
}
.speech {
  font-size: 15px;
}
.actions {
  margin-top: 20px;
  display: flex;
  gap: 12px;
}
.question {
  margin-bottom: 18px;
}
.q-text {
  margin-bottom: 8px;
  color: #303133;
}
</style>
