# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=multimodal

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=multimodal
MINIO_SECURE=false

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=segments

# 模型开关（默认 false = 使用轻量占位实现，可直接运行）
USE_REAL_ASR=false
USE_REAL_EMOTION=false
USE_REAL_EMBEDDING=false
EMBEDDING_DIM=512